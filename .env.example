# Copy this file to .env and fill in your own values. .env is git-ignored and must never be committed.

# Your Discogs username (the account whose wantlist is shopped).
DISCOGS_USERNAME=

# Personal access token: discogs.com > Settings > Developers > "Generate new token".
DISCOGS_TOKEN=

# Country code the sellers ship to (ISO 3166-1 alpha-2); used for shipping quotes.
DEFAULT_SHIP_TO=DK

# Currency used for totals (ISO 4217).
DEFAULT_CURRENCY=DKK

# Set to 1 to run the scraping Chrome without a window (off by default; a visible window gets past
# Cloudflare more reliably).
SCRAPER_HEADLESS=
